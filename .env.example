# ==============================================================================
# JARVIS COMMAND CENTER — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.local and configure your keys.
# ==============================================================================

# --- ELEVENLABS NEURAL VOICE SYNTHESIS (OPTIONAL) ---
# If omitted, Jarvis automatically activates native browser speech synthesis fallback.
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- SUPABASE DATABASE & VECTOR VAULT (PHASE 2 LIVE BACKEND) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- N8N AUTOMATION ENGINE & WEBHOOK BUS (OPTIONAL) ---
N8N_WEBHOOK_BASE_URL=https://n8n.yourdomain.com/webhook/
INTERNAL_WEBHOOK_SECRET=your_internal_shared_secret_token_here

# --- SYSTEM TELEMETRY & CLUSTERING (OPTIONAL) ---
NEXT_PUBLIC_CLUSTER_ENVIRONMENT=production
NEXT_PUBLIC_DEFAULT_REGION=iad1
